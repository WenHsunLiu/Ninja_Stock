# Supabase Configuration
# 在 Supabase 專案設定中的 API 頁面取得
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder

# 行情同步與連線檢查需要使用獨立的 Supabase Auth 帳號
SUPABASE_SYNC_EMAIL=
SUPABASE_SYNC_PASSWORD=

# Optional: Stock API keys (依 Sprint 需求擴充)
# FINMIND_API_TOKEN=your_token_here
